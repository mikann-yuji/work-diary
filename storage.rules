rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/medicalRecords/{recordId}/{allPaths=**} {
      allow read:
        if request.auth != null
        && request.auth.uid == userId;

      allow write:
        if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null || (
          request.resource.size < 12 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg'
        ));
    }

    // Keep previously uploaded images private and readable by their owner.
    match /users/{userId}/medical-records/{recordId}/{allPaths=**} {
      allow read, delete:
        if request.auth != null
        && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

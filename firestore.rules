rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update, delete:
        if request.auth != null
        && request.auth.uid == userId;

      match /records/{recordDate} {
        allow read, delete:
          if request.auth != null
          && request.auth.uid == userId;

        allow create, update:
          if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.date == recordDate
          && request.resource.data.schemaVersion is int;
      }

      match /medicalRecords/{recordId} {
        allow read, delete:
          if request.auth != null
          && request.auth.uid == userId;

        allow create, update:
          if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.medicalRecordId == recordId
          && request.resource.data.uid == userId
          && request.resource.data.visitDate is string
          && request.resource.data.department is string
          && request.resource.data.schemaVersion is int;
      }
    }

    // Cloud Functions (Admin SDK) only. Clients cannot forge notification state.
    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
